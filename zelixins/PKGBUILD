# PKGBUILD - ZelixOS GUI Installer
pkgname=zelixins
pkgver=1.2.1
pkgrel=1
pkgdesc="Official graphical installer for ZelixOS"
arch=('any')
options=('!debug' '!strip')
url="https://github.com/ZelixOS/zelixins"
license=('GPL')
depends=('python' 'python-pyqt6' 'qt6-imageformats' 'archinstall' 'arch-install-scripts' 'polkit' 'util-linux')

source=("myself.py" "installer_support.py" "desktop_catalog.py" "desktop_page.py"
        "desktop_setup.py" "desktop_theme.py" "zelix-installer.desktop" "zelix_post_install.sh")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    # 1. Gerekli sistem dizinlerini oluştur
    install -d "$pkgdir/usr/share/zelixins"
    install -d "$pkgdir/usr/share/applications"
    install -d "$pkgdir/usr/bin"

    # 2. Tüm kaynak dosyalarını /usr/share/zelixins altına kopyala
    cp -rp "$startdir/myself.py" "$startdir/installer_support.py" "$startdir/desktop_catalog.py" "$startdir/desktop_page.py" "$startdir/desktop_setup.py" "$startdir/desktop_theme.py" "$startdir/icons" "$startdir/previews" "$startdir/backgrounds" "$startdir/zelixdeps" "$startdir/zelix_post_install.sh" "$pkgdir/usr/share/zelixins/"

    find "$pkgdir/usr/share/zelixins" -type d -name __pycache__ -prune -exec rm -rf {} +

    # 3. .desktop dosyasını uygulamalar menüsüne kopyala
    install -m755 "$startdir/zelix-installer.desktop" "$pkgdir/usr/share/applications/zelix-installer.desktop"

    # 4. Terminalden çalıştırma kolaylığı (Symlink)
    ln -s /usr/share/zelixins/myself.py "$pkgdir/usr/bin/zelix-installer"
    ln -s /usr/share/zelixins/myself.py "$pkgdir/usr/bin/zelixins"
    
    # Çalıştırma yetkilerini garantile
    chmod +x "$pkgdir/usr/share/zelixins/myself.py"
    chmod +x "$pkgdir/usr/share/zelixins/zelix_post_install.sh"
}
