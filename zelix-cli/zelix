t() {
    local key=$1 text
    shift
    case "$ZELIX_LANG" in
        tr) text=${MSG_TR[$key]:-${MSG_EN[$key]:-$key}};;
        es) text=${MSG_ES[$key]:-${MSG_EN[$key]:-$key}};;
        *) text=${MSG_EN[$key]:-$key};;
    esac
    printf -- "$text" "$@"
}

print_banner() {
    echo -e "${C_BOLD}${C_WHITE}"
    cat << "BANNER"
  ____      _ _       ___  ____
 |_  / ___ | (_)_  __/ _ \/ ___|
  / / / _ \| | \ \/ / | | \___ \
 / /_|  __/| | |>  <| |_| |___) |
/____|\___||_|_/_/\_\\___/|____/
BANNER
    echo -e "${C_WHITE}${C_BOLD}ZelixOS${C_RESET} ${C_LIGHT_GRAY}$(t title)${C_RESET} ${C_GRAY}(v1.3.0)${C_RESET}\n"
}

set_language() {
    local code=${1,,}
    case "$code" in
        en|english) code=en;; tr|turkish|türkçe) code=tr;; es|spanish|español) code=es;;
        *) t language_usage; echo; return 2;;
    esac
    mkdir -p "$CONFIG_DIR"
    local preference_file
    preference_file=$(mktemp "$CONFIG_DIR/.cli-language.XXXXXXXX")
    printf 'ZELIX_LANG="%s"\n' "$code" > "$preference_file"
    mv -- "$preference_file" "$CONFIG_FILE"
    ZELIX_LANG=$code
    echo -e "${C_WHITE}[OK] $(t language_set)${C_RESET}"
}

print_help() {
    print_banner
    echo -e "${C_BOLD}${C_WHITE}$(t usage)${C_RESET}"
    echo "  $(t usage_arguments)"
    echo
    echo -e "${C_BOLD}${C_WHITE}$(t commands)${C_RESET}"
    local pair command key
    for pair in 'update, u:help_update' 'mirrors, m:help_mirrors' 'clean, c:help_clean' 'flathub, f:help_flathub' 'info, i:help_info' 'hello, h:help_hello' 'lang [en|tr|es]:help_language' 'help, -h:help_help'; do
        command=${pair%%:*}; key=${pair#*:}
        printf '  %-19s %s\n' "$command" "$(t "$key")"
    done
    echo
}

do_update() {
    print_banner
    echo -e "${C_WHITE}==> $(t updating)${C_RESET}"
    if command -v paru &>/dev/null; then paru -Syu
    elif command -v yay &>/dev/null; then yay -Syu
    else sudo pacman -Syu; fi
    if command -v flatpak &>/dev/null; then
        echo -e "\n${C_WHITE}==> $(t flatpak_updating)${C_RESET}"
        flatpak update -y || true
    fi
    echo -e "\n${C_WHITE}[OK] $(t update_done)${C_RESET}"
}

do_mirrors() {
    print_banner
    echo -e "${C_WHITE}==> $(t mirrors_running)${C_RESET}"
    if command -v rate-mirrors &>/dev/null; then
        local country="" var val
        for var in LANG LC_ADDRESS LC_ALL; do
            val="${!var}"
            if [[ -n "$val" && "$val" == *"_"* ]]; then
                country=$(echo "$val" | cut -d'_' -f2 | cut -d'.' -f1 | tr '[:lower:]' '[:upper:]')
                break
            fi
        done
        if [[ -n "$country" && ${#country} -eq 2 ]]; then
            echo "$(t country "$country")"
            rate-mirrors --allow-root --entry-country "$country" arch | sudo tee /etc/pacman.d/mirrorlist > /dev/null
        else
            rate-mirrors --allow-root arch | sudo tee /etc/pacman.d/mirrorlist > /dev/null
        fi
        echo -e "${C_WHITE}[OK] $(t mirrors_done)${C_RESET}"
    else
        echo "$(t mirrors_missing)"
        sudo pacman -S --noconfirm rate-mirrors-bin 2>/dev/null || (command -v paru &>/dev/null && paru -S --noconfirm rate-mirrors-bin) || (command -v yay &>/dev/null && yay -S --noconfirm rate-mirrors-bin) || sudo pacman -S --noconfirm reflector
    fi
}

do_clean() {
    print_banner
    echo -e "${C_WHITE}==> $(t cleaning)${C_RESET}"
    sudo pacman -Sc --noconfirm
    echo -e "\n${C_WHITE}==> $(t orphans_scanning)${C_RESET}"
    local orphans
    orphans=$(pacman -Qdtq || true)
    if [[ -n "$orphans" ]]; then
        echo "$(t orphans_remove "$orphans")"
        echo "$orphans" | sudo pacman -Rns - --noconfirm
    else
        echo "$(t no_orphans)"
    fi
    echo -e "\n${C_WHITE}[OK] $(t clean_done)${C_RESET}"
}

do_flathub() {
    print_banner
    echo -e "${C_WHITE}==> $(t flathub_configuring)${C_RESET}"
    if ! command -v flatpak &>/dev/null; then
        echo "$(t flatpak_installing)"
        sudo pacman -S --noconfirm flatpak
    fi
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    echo -e "${C_WHITE}[OK] $(t flathub_done)${C_RESET}"
}

do_info() {
    if command -v fastfetch &>/dev/null; then fastfetch
    else
        print_banner
        echo -e "${C_BOLD}${C_WHITE}$(t system_summary)${C_RESET}"
        echo "  $(t os): $(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d'=' -f2 | tr -d '\"' || echo 'ZelixOS')"
        echo "  $(t kernel): $(uname -r)"
        echo "  $(t uptime): $(uptime -p 2>/dev/null || uptime)"
        echo "  $(t desktop): ${XDG_CURRENT_DESKTOP:-KDE Plasma}"
        echo "  $(t memory): $(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
    fi
}

do_hello() {
    if command -v zelix-hello &>/dev/null; then zelix-hello &
    elif [[ -f /usr/share/zelix-hello/main.py ]]; then python /usr/share/zelix-hello/main.py &
    else echo "$(t hello_missing)"; fi
}

case "${1:-help}" in
    update|u) do_update;; mirrors|m) do_mirrors;; clean|c) do_clean;;
    flathub|flatpak|f) do_flathub;; info|i) do_info;; hello|h) do_hello;;
    lang|language) set_language "${2:-}";; help|-h|--help) print_help;;
    *) echo "$(t unknown "$1")"; print_help; exit 1;;
esac
