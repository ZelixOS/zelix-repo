#!/usr/bin/env bash
# ZelixOS command-line management. English, Turkish, and Spanish.
set -e
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zelix"
CONFIG_FILE="$CONFIG_DIR/cli.conf"

detect_language() {
    # Read only the supported preference; never execute a configuration file.
    if [[ -z ${ZELIX_LANG:-} && -f $CONFIG_FILE ]]; then
        while IFS= read -r line; do
            case "$line" in
                'ZELIX_LANG="en"'|'ZELIX_LANG=en') ZELIX_LANG=en;;
                'ZELIX_LANG="tr"'|'ZELIX_LANG=tr') ZELIX_LANG=tr;;
                'ZELIX_LANG="es"'|'ZELIX_LANG=es') ZELIX_LANG=es;;
            esac
            [[ -z ${ZELIX_LANG:-} ]] || break
        done < "$CONFIG_FILE"
    fi
    if [[ -z ${ZELIX_LANG:-} ]]; then
        local locale_value=${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}
        case ${locale_value,,} in tr*) ZELIX_LANG=tr;; es*) ZELIX_LANG=es;; *) ZELIX_LANG=en;; esac
    fi
    ZELIX_LANG=${ZELIX_LANG,,}
    case $ZELIX_LANG in en|tr|es) ;; *) ZELIX_LANG=en;; esac
}
detect_language
