# PKGBUILD - Paru AUR Helper (Binary - libalpm.so.16)
pkgname=paru
pkgver=2.1.0
pkgrel=2
pkgdesc="Feature packed AUR helper"
arch=('x86_64')
url="https://github.com/morganamilo/paru"
license=('GPL-3.0-or-later')
depends=('git' 'pacman' 'libalpm.so>=14')
optdepends=('bat: colored pkgbuild printing'
            'devtools: build in chroot and downloading pkgbuilds')
provides=('paru')
conflicts=()
backup=('etc/paru.conf')

# No source needed - we package from local files
source=()
sha256sums=()

package() {
    # Use pre-staged files from pkg_new/ (built from host's paru binary linked against libalpm.so.16)
    local _pkgfiles="$startdir/pkg_new"

    install -Dm755 "$_pkgfiles/usr/bin/paru"           "$pkgdir/usr/bin/paru"
    install -Dm644 "$_pkgfiles/etc/paru.conf"          "$pkgdir/etc/paru.conf"

    install -Dm644 "$_pkgfiles/usr/share/bash-completion/completions/paru" \
                   "$pkgdir/usr/share/bash-completion/completions/paru"
    install -Dm644 "$_pkgfiles/usr/share/man/man8/paru.8.gz" \
                   "$pkgdir/usr/share/man/man8/paru.8.gz"
    install -Dm644 "$_pkgfiles/usr/share/man/man5/paru.conf.5.gz" \
                   "$pkgdir/usr/share/man/man5/paru.conf.5.gz"
    install -Dm644 "$_pkgfiles/usr/share/zsh/site-functions/_paru" \
                   "$pkgdir/usr/share/zsh/site-functions/_paru"
}
